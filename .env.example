# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
# Without these, Kredit runs fully in the browser (local demo mode).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Never the secret / service role key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
